{
  "name": "odyssey-restaurant-ops",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:dashboard": "turbo run dev --filter=dashboard",
    "dev:backend": "turbo run dev --filter=backend",
    "gen:contract": "turbo run gen:spec --filter=backend && turbo run gen:client --filter=@odyssey/api-client",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.10.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
