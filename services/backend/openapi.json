{
  "openapi": "3.1.0",
  "info": {
    "title": "Odyssey Restaurant Ops API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "MenuCategoryList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuCategory"
        }
      },
      "MenuCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "sortOrder",
          "createdAt",
          "updatedAt"
        ]
      },
      "MenuItemList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuItem"
        }
      },
      "MenuItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "priceCents": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "isAvailable": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "categoryId",
          "name",
          "description",
          "priceCents",
          "isAvailable",
          "createdAt",
          "updatedAt"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/menu/categories": {
      "get": {
        "operationId": "listMenuCategories",
        "tags": [
          "menu"
        ],
        "responses": {
          "200": {
            "description": "Menu categories ordered for display",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuCategoryList"
                }
              }
            }
          }
        }
      }
    },
    "/menu/items": {
      "get": {
        "operationId": "listMenuItems",
        "tags": [
          "menu"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "categoryId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "available",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Menu items, optionally filtered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItemList"
                }
              }
            }
          },
          "400": {
            "description": "Request could not be processed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/menu/items/{id}": {
      "get": {
        "operationId": "getMenuItem",
        "tags": [
          "menu"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "A single menu item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
