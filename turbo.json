{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "gen:spec": {
      "cache": false,
      "outputs": ["openapi.json"]
    },
    "gen:client": {
      "cache": false,
      "outputs": ["src/generated/**"]
    }
  }
}
